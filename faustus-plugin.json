{
  "schema": 1,
  "x-family": {
    "copilot": {
      "version": 1,
      "info": "/api/copilot/info",
      "panel": "/api/copilot/panel.js",
      "proxy": "/api/copilot/proxy",
      "launcher": "/api/copilot/launcher.js",
      "context": "window.hoardCopilot.context",
      "refresh": "window.hoardCopilot.onTurnEnd"
    },
    "absorbed_by": {
      "id": "borges",
      "repository": "https://github.com/Luissalet/BorgesHoard",
      "module": "links",
      "standalone": false
    }
  },
  "id": "links",
  "name": "Links Hoard · Borges",
  "purpose": "Absorbed by Borges's Hoard. Native compatibility identity only; no standalone server. Read-later bookmark library with extracted article text, tags and highlights, stored locally; also downloads the video, audio or photos behind a link (YouTube, X, Instagram, TikTok…) to disk.",
  "capabilities": [
    "bookmarks",
    "read-later",
    "extraction",
    "tags",
    "highlights",
    "search",
    "digest",
    "import",
    "watches",
    "feeds",
    "github-releases",
    "page-changes",
    "event-bus",
    "media-download",
    "video-download",
    "audio-download",
    "highlights-to-flashcards",
    "resurface",
    "time-budgeted-reading-plan",
    "daily-digest",
    "job-events"
  ],
  "placeholders": [
    "LINKS_DIR",
    "APP_URL",
    "TOKEN_FILE"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5184/links",
    "TOKEN_FILE": "{LINKS_DIR}/data/mcp-token",
    "BORGES_DIR": "{LINKS_DIR}/../Borges's Hoard"
  },
  "app": {
    "url_default": "http://127.0.0.1:5184/links",
    "ui_url": "http://127.0.0.1:5184/",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "absorbed-links"
      }
    },
    "identify": {
      "service": [
        "links-hoard"
      ],
      "title": [
        "links hoard"
      ]
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{BORGES_DIR}/venv/Scripts/python.exe",
    "args": [
      "{BORGES_DIR}/mcp_server.py"
    ],
    "env": {
      "BORGES_URL": "http://127.0.0.1:5184",
      "BORGES_TOKEN_FILE": "{BORGES_DIR}/data/mcp-token"
    },
    "optional_env": [
      "BORGES_DATA_DIR"
    ]
  },
  "notes": "Absorbed by Borges's Hoard: https://github.com/Luissalet/BorgesHoard. This identity preserves native tokens and references; it cannot start or stop the merged process. Start Borges explicitly and enable its module there."
}
